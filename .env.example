# ─── Database ─────────────────────────────────────────────────────────────
# SQLite for local/dev. Swap to a Postgres connection string when scaling.
DATABASE_URL="file:./dev.db"

# ─── Admin auth ───────────────────────────────────────────────────────────
# Used to sign admin session cookies. Set a long random value in production.
SESSION_SECRET=dev-insecure-secret-change-me
# Seed credentials for the default admin account (see prisma/seed.ts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rudransh123

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Optional supporting services (phase 2+) ──────────────────────────────
# Sanity CMS (Journal + product education)
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# Klaviyo (lifecycle email)
# KLAVIYO_PUBLIC_KEY=
# Analytics (Plausible / GA4)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
